<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="QuestionnaireApp.MainPage"
    Title="Чайный Сомелье"
    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C1E}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="18">
            
            <HorizontalStackLayout HorizontalOptions="End" Spacing="8" Margin="0,0,0,10">
                <Label 
                    Text="Тёмная тема:" 
                    VerticalOptions="Center" 
                    FontSize="14" 
                    TextColor="{AppThemeBinding Light=#3A3A3C, Dark=#E5E5EA}"/>
                <Switch 
                    x:Name="ThemeSwitch" 
                    OnColor="Green" 
                    Toggled="OnThemeToggled"/>
            </HorizontalStackLayout>

            <Image 
                Source="https://storage01.tea.ru/iblock/e9d/e9d4876c4fcb38ac765536bebfea531d/65083b09d5ae487f4975a1e3a76022c5_80.jpg"
                Aspect="AspectFill"
                HeightRequest="180"
                HorizontalOptions="Fill"
                Margin="0,0,0,10"/>

            <Label 
                Text="Анкета Дегустации Чайных Сортов" 
                FontSize="22" 
                FontAttributes="Bold" 
                TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"
                HorizontalOptions="Center" 
                HorizontalTextAlignment="Center"/>

            <Grid 
                ColumnDefinitions="*, 1.8*" 
                RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" 
                RowSpacing="14" 
                Margin="0,10,0,10">
                
                <Label 
                    Grid.Row="0" Grid.Column="0" 
                    Text="Дегустатор:" 
                    VerticalOptions="Center" 
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
                <Entry 
                    Grid.Row="0" Grid.Column="1" 
                    x:Name="TesterNameEntry" 
                    Placeholder="Ваше имя" 
                    MaxLength="25" 
                    Keyboard="Text"
                    TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                    PlaceholderColor="Gray"/>

                <Label 
                    Grid.Row="1" Grid.Column="0" 
                    Text="Дата сессии:" 
                    VerticalOptions="Center"
                    TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
                <DatePicker 
                    Grid.Row="1" Grid.Column="1" 
                    x:Name="TastingDatePicker" 
                    Format="dd.MM.yyyy"
                    MinimumDate="2020-01-01"
                    MaximumDate="2030-12-31"
                    TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>

                <Label 
                    Grid.Row="2" Grid.Column="0" 
                    Text="Сорт чая:" 
                    VerticalOptions="Center" 
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
                <Entry 
                    Grid.Row="2" Grid.Column="1" 
                    x:Name="TeaNameEntry" 
                    Placeholder="Например, Да Хун Пао" 
                    MaxLength="40" 
                    Keyboard="Text"
                    TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                    PlaceholderColor="Gray"/>

                <Label 
                    Grid.Row="3" Grid.Column="0" 
                    Text="Вид чая:" 
                    VerticalOptions="Center"
                    TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
                <Picker 
                    Grid.Row="3" Grid.Column="1" 
                    x:Name="TeaTypePicker" 
                    Title="Выберите категорию"
                    TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                    TitleColor="Gray">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Зелёный чай</x:String>
                            <x:String>Белый чай</x:String>
                            <x:String>Улуны (Светлые / Тёмные)</x:String>
                            <x:String>Пуэры (Шу / Шен)</x:String>
                            <x:String>Красный (Черный по-европейски)</x:String>
                            <x:String>Тизаны / Травяные сборы</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Label 
                    Grid.Row="4" Grid.Column="0" 
                    Text="Метод варки:" 
                    VerticalOptions="Center"
                    TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
                <Picker 
                    Grid.Row="4" Grid.Column="1" 
                    x:Name="BrewMethodPicker" 
                    Title="Как заваривали?"
                    TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                    TitleColor="Gray">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Китайский пролив</x:String>
                            <x:String>Настаивание в чайнике</x:String>
                            <x:String>Бумажный стаканчик</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Label 
                    Grid.Row="5" Grid.Column="0" 
                    Text="Ваша оценка:" 
                    VerticalOptions="Center"
                    TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
                <VerticalStackLayout Grid.Row="5" Grid.Column="1" Spacing="2">
                    <Slider 
                        x:Name="ScoreSlider" 
                        Minimum="1" 
                        Maximum="10" 
                        Value="5" />
                    <Label 
                        Text="{Binding Source={x:Reference ScoreSlider}, Path=Value, StringFormat='Итоговый балл: {0:F0} из 10'}" 
                        FontSize="12" 
                        TextColor="Green" 
                        FontAttributes="Italic"/>
                </VerticalStackLayout>
            </Grid>

            <Label 
                Text="Чайное состояние (Эффект):" 
                FontAttributes="Bold" 
                Margin="0,5,0,2"
                TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
            <VerticalStackLayout Spacing="6" Margin="5,0,0,10">
                <RadioButton 
                    x:Name="BodrostRadio"
                    Content="Бодрость / Активный физический тонус" 
                    GroupName="TeaEffect" 
                    Value="Бодрость" 
                    IsChecked="True"
                    TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
                <RadioButton 
                    x:Name="FocusRadio" 
                    Content="Фокус / Ясность ума и концентрация" 
                    GroupName="TeaEffect" 
                    Value="Фокус"
                    TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
                <RadioButton 
                    x:Name="RelaxRadio"
                    Content="Расслабление / Ментальная медитация" 
                    GroupName="TeaEffect" 
                    Value="Расслабление"
                    TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
            </VerticalStackLayout>

            <Label 
                Text="Использованные добавки (исказители вкуса):" 
                FontAttributes="Bold" 
                Margin="0,5,0,2"
                TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
            <VerticalStackLayout Spacing="4" Margin="5,0,0,10">
                <HorizontalStackLayout Spacing="8">
                    <CheckBox x:Name="SugarCheckBox" Color="Red"/>
                    <Label 
                        Text="Подсластитель (Сахар / Сироп / Мёд)" 
                        VerticalOptions="Center" 
                        TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <CheckBox x:Name="MilkCheckBox" Color="Blue"/>
                    <Label 
                        Text="Молоко / Сливки" 
                        VerticalOptions="Center" 
                        TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <CheckBox x:Name="LemonCheckBox" Color="Yellow"/>
                    <Label 
                        Text="Лимон / Цитрусовый сок" 
                        VerticalOptions="Center" 
                        TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Label 
                Text="Дегустационные заметки (аромат, вкус, профиль):" 
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
            <Editor 
                x:Name="ReviewEditor" 
                Placeholder="Опишите нотки послевкусия, терпкость, плотность..." 
                HeightRequest="90" 
                AutoSize="TextChanges" 
                MaxLength="300"
                TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                PlaceholderColor="Gray"/>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,15,0,10">
                <Button 
                    Grid.Column="0" 
                    Text="Очистить форму" 
                    Clicked="OnClearFormClicked" 
                    BackgroundColor="#AEAEB2" 
                    TextColor="White"/>
                <Button 
                    Grid.Column="1" 
                    Text="Отправить" 
                    Clicked="OnSubmitFormClicked" 
                    BackgroundColor="Green" 
                    TextColor="White"/>
            </Grid>

            <Border 
                x:Name="ResultCard" 
                IsVisible="False" 
                Stroke="Green" 
                StrokeThickness="2" 
                StrokeShape="RoundRectangle 10" 
                Padding="15" 
                BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                Margin="0,10,0,20">
                <VerticalStackLayout Spacing="6">
                    <Label 
                        Text="📋 Итоговый Лист Дегустации:" 
                        FontAttributes="Bold" 
                        FontSize="16" 
                        TextColor="Green"/>
                    <Label 
                        x:Name="ResultSummaryLabel" 
                        Text="" 
                        FontSize="14" 
                        TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
