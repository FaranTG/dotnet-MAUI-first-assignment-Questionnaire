<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="QuestionnaireApp.MainPage"
    Title="Чайный Сомелье"
    Shell.TitleColor="#FF8C00"
    Shell.BackgroundColor="Gray"
    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C1E}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="18">
            <HorizontalStackLayout HorizontalOptions="End" Spacing="8" Margin="0,0,0,10">
                <Label 
                    Text="Тёмная тема:" 
                    VerticalOptions="Center" 
                    FontSize="14" 
                    TextColor="{AppThemeBinding Light=#3A3A3C, Dark=#E5E5EA}"/>
                <Switch 
                    x:Name="ThemeSwitch" 
                    OnColor="Orange" 
                    Toggled="OnThemeToggled"/>
            </HorizontalStackLayout>

            <Image 
                Source="tea_questionnaire.jpg"
                Aspect="AspectFill"
                HeightRequest="180"
                HorizontalOptions="Fill"
                Margin="0,0,0,10"/>

            <Label 
                Text="Анкета дегустации чайных сортов" 
                FontSize="22" 
                FontAttributes="Bold" 
                TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"
                HorizontalOptions="Center" 
                HorizontalTextAlignment="Center"/>

            <Grid 
                ColumnDefinitions="*, 1.8*" 
                RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto" 
                RowSpacing="14" 
                Margin="0,10,0,10">
                
                <Label Grid.Row="0" Grid.Column="0" Text="Дегустатор:" Style="{StaticResource FormLabelStyle}"/>
                <Entry 
                    Grid.Row="0" Grid.Column="1" 
                    x:Name="TesterNameEntry" 
                    Placeholder="Ваше имя" 
                    MaxLength="25" 
                    Keyboard="Text"
                    TextChanged="OnRequiredFieldsChanged"
                    Style="{StaticResource FieldEntryStyle}"/>
                
                <Label Grid.Row="1" Grid.Column="0" Text="Почта:" Style="{StaticResource FormLabelStyle}"/>
                <Entry 
                    Grid.Row="1" Grid.Column="1" 
                    x:Name="TesterEmailEntry" 
                    Placeholder="example@mail.com" 
                    MaxLength="50" 
                    Keyboard="Email"
                    TextChanged="OnRequiredFieldsChanged"
                    Style="{StaticResource FieldEntryStyle}"/>

                <Label Grid.Row="2" Grid.Column="0" Text="Дата сессии:" Style="{StaticResource FormLabelStyle}"/>
                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*, Auto">
                    <Entry 
                        Grid.Column="0"
                        x:Name="DateEntry"
                        Placeholder="ДД.ММ.ГГГГ"
                        Keyboard="Numeric"
                        MaxLength="10"
                        TextChanged="OnDateTextChanged"
                        Style="{StaticResource FieldEntryStyle}"/>

                    <Border 
                        Grid.Column="1"
                        StrokeShape="RoundRectangle 6"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#444446}"
                        BackgroundColor="Transparent"
                        Margin="5,0,0,0"
                        Padding="0"
                        WidthRequest="45"
                        HeightRequest="40">
                        <Grid>
                            <Button 
                                Text="📅"
                                Padding="0"
                                FontSize="16"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                WidthRequest="45"
                                HeightRequest="40"
                                BackgroundColor="Transparent"
                                TextColor="#FF8C00"
                                Clicked="OnCalendarButtonClicked"/>

                            <DatePicker 
                                x:Name="HiddenDatePicker"
                                IsVisible="True"
                                Opacity="0"
                                WidthRequest="45"
                                HeightRequest="40"
                                Format="dd.MM.yyyy"
                                MinimumDate="10/01/2026"
                                MaximumDate="12/31/2026"
                                DateSelected="OnDateSelectedFromCalendar"/>
                        </Grid>
                    </Border>
                </Grid>

                <Label Grid.Row="3" Grid.Column="0" Text="Сорт чая:" Style="{StaticResource FormLabelStyle}"/>
                <Entry 
                    Grid.Row="3" Grid.Column="1" 
                    x:Name="TeaNameEntry" 
                    Placeholder="Например, Гекуро" 
                    MaxLength="40" 
                    Keyboard="Text"
                    TextChanged="OnRequiredFieldsChanged"
                    Style="{StaticResource FieldEntryStyle}"/>

                <Label Grid.Row="4" Grid.Column="0" Text="Вид чая:" Style="{StaticResource FormLabelStyle}"/>
                <Picker 
                    Grid.Row="4" Grid.Column="1" 
                    x:Name="TeaTypePicker" 
                    Style="{StaticResource FieldPickerStyle}">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Выберите вид...</x:String>
                            <x:String>Зелёный</x:String>
                            <x:String>Черный</x:String>
                            <x:String>Белый</x:String>
                            <x:String>Улун</x:String>
                            <x:String>Пуэр</x:String>
                            <x:String>Тизан</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Label Grid.Row="5" Grid.Column="0" Text="Метод варки:" Style="{StaticResource FormLabelStyle}"/>
                <Picker 
                    Grid.Row="5" Grid.Column="1" 
                    x:Name="BrewMethodPicker" 
                    Style="{StaticResource FieldPickerStyle}">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Выберите метод...</x:String>
                            <x:String>Китайский пролив</x:String>
                            <x:String>Настаивание в чайнике</x:String>
                            <x:String>Бумажный стаканчик</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Label Grid.Row="6" Grid.Column="0" Text="Ваша оценка:" Style="{StaticResource FormLabelStyle}"/>
                <VerticalStackLayout Grid.Row="6" Grid.Column="1" Spacing="2">
                    <Slider 
                        x:Name="ScoreSlider" 
                        Minimum="0" 
                        Maximum="10" 
                        Value="5"
                        ThumbColor="Orange"
                        MinimumTrackColor="Orange"
                        MaximumTrackColor="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}"/>
                    <Label 
                        Text="{Binding Source={x:Reference ScoreSlider}, Path=Value, Mode=OneWay, StringFormat='Итоговый балл: {0:F0} из 10'}" 
                        FontSize="12" 
                        TextColor="Orange" 
                        FontAttributes="Italic"/>
                </VerticalStackLayout>
            </Grid>

            <Label Text="Эффект от чаепития:" Style="{StaticResource FormLabelStyle}" Margin="0,5,0,2"/>
            <VerticalStackLayout Spacing="6" Margin="5,0,0,10">
                <RadioButton 
                    x:Name="BoostRadioButton"
                    Content="Бодрость" 
                    GroupName="TeaEffect" 
                    Value="Бодрость" 
                    IsChecked="True"
                    TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
                <RadioButton 
                    x:Name="ConcentrationRadioButton" 
                    Content="Концентрация" 
                    GroupName="TeaEffect" 
                    Value="Концентрация"
                    TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
                <RadioButton 
                    x:Name="RelaxRadioButton"
                    Content="Расслабление" 
                    GroupName="TeaEffect" 
                    Value="Расслабление"
                    TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
            </VerticalStackLayout>

            <Label Text="Использованные добавки:" Style="{StaticResource FormLabelStyle}" Margin="0,5,0,2"/>
            <VerticalStackLayout Spacing="4" Margin="5,0,0,10">
                <HorizontalStackLayout Spacing="8">
                    <CheckBox x:Name="SugarCheckBox" Color="Orange"/>
                    <Label 
                        Text="Подсластитель" 
                        VerticalOptions="Center" 
                        TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLabelTapped" CommandParameter="{x:Reference SugarCheckBox}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
                
                <HorizontalStackLayout Spacing="8">
                    <CheckBox x:Name="MilkCheckBox" Color="Orange"/>
                    <Label 
                        Text="Молоко" 
                        VerticalOptions="Center" 
                        TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLabelTapped" CommandParameter="{x:Reference MilkCheckBox}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
                
                <HorizontalStackLayout Spacing="8">
                    <CheckBox x:Name="LemonCheckBox" Color="Orange"/>
                    <Label 
                        Text="Лимон" 
                        VerticalOptions="Center" 
                        TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLabelTapped" CommandParameter="{x:Reference LemonCheckBox}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Label Text="Дегустационные заметки:" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,6"/>
            <Editor 
                x:Name="ReviewEditor" 
                Placeholder="Опишите нотки послевкусия, терпкость, плотность..." 
                HeightRequest="90" 
                AutoSize="TextChanges" 
                MaxLength="300"
                PlaceholderColor="Gray"
                TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"/>

            <Label 
                x:Name="ValidationWarningLabel"
                Text="Для отправки заполните обязательные поля: дегустатор, почта, сорт чая"
                TextColor="Red"
                FontSize="12"
                HorizontalOptions="Center"
                Margin="0,15,0,0"/>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,5,0,10">
                <Button 
                    Grid.Column="0" 
                    Text="Очистить форму" 
                    Clicked="OnClearFormClicked" 
                    BackgroundColor="#AEAEB2" 
                    TextColor="White"/>
                <Button 
                    Grid.Column="1" 
                    x:Name="SubmitButton"
                    Text="Отправить" 
                    Clicked="OnSubmitFormClicked" 
                    TextColor="White" />
            </Grid>

            <Border 
                x:Name="ResultCard" 
                IsVisible="False" 
                Stroke="Orange" 
                StrokeThickness="2" 
                StrokeShape="RoundRectangle 10" 
                Padding="15" 
                BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                Margin="0,10,0,20">
                <VerticalStackLayout Spacing="6">
                    <Label 
                        Text="📋 Итоги дегустации:" 
                        FontAttributes="Bold" 
                        FontSize="16" 
                        TextColor="Orange"/>
                    <Label 
                        x:Name="ResultSummaryLabel" 
                        Text="" 
                        FontSize="14" 
                        TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>